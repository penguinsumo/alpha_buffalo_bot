//@version=6
indicator("AlphaBuff Gold Analyzer v2.4.2 - Decision Stack", overlay=true, max_labels_count=300, max_boxes_count=30, max_lines_count=30)

// Execution is designed to run on a 5-minute chart. H4 supplies PRZ/context,
// H1 supplies the frozen tunnel geometry, and closed M15 supplies the sweep and
// HA trigger. Every higher-timeframe decision uses the last confirmed source
// bar (offset [1] + lookahead_on).

// =============================================================================
// 1. INPUTS
// =============================================================================

groupTf = "01. Timeframes / Sessions"
contextTf       = input.timeframe("1D",  "Context timeframe", group=groupTf)
rangeTfD        = input.timeframe("1D",  "Cluster TF 1", group=groupTf)
rangeTfH4       = input.timeframe("240", "Cluster TF 2", group=groupTf)
rangeTfH1       = input.timeframe("60",  "Cluster TF 3", group=groupTf)
triggerTf       = input.timeframe("15",  "HA / PA trigger TF", group=groupTf)
structureTf     = input.timeframe("60",  "BOS / CHoCH TF", group=groupTf)
entryConfirmTf  = input.timeframe("60",  "Asymmetric entry confirmation TF", group=groupTf)
marketTimezone  = input.string("Asia/Bangkok", "Session timezone", group=groupTf)
marketSession   = input.session("0000-2359:23456", "Alert session (Mon-Fri)", group=groupTf)
asiaSession     = input.session("0600-1500:23456", "Asia session", group=groupTf)
requireExchangeMarket = input.bool(true, "Require exchange regular session", group=groupTf)
enforceSafeTf   = input.bool(true, "Require chart TF <= trigger TF", group=groupTf,
     tooltip="Use this script on a 5m chart; final HA decisions still wait for a confirmed 15m candle.")

groupContext = "02. Directional Context"
emaLen            = input.int(200, "EMA length", minval=20, group=groupContext)
rsiLen            = input.int(14, "RSI length", minval=2, group=groupContext)
dxySymbol         = input.symbol("TVC:DXY", "DXY symbol", group=groupContext)
gcSymbol          = input.symbol("COMEX:GC1!", "GC futures confirmation symbol", group=groupContext)
contextThreshold  = input.int(2, "Directional score required", minval=1, maxval=3, group=groupContext)

groupPrz = "03. PRZ / Cluster"
asiaFibMin       = input.float(0.618, "Asia Fib near", minval=0.50, maxval=1.0, step=0.001, group=groupPrz)
asiaFibMax       = input.float(0.705, "Asia Fib deep", minval=0.50, maxval=1.0, step=0.001, group=groupPrz)
deepFibMin       = input.float(0.720, "Non-Asia Fib near", minval=0.50, maxval=1.0, step=0.001, group=groupPrz)
deepFibMax       = input.float(0.880, "Non-Asia Fib deep", minval=0.50, maxval=1.0, step=0.001, group=groupPrz)
lookbackD        = input.int(20, "Daily range lookback", minval=5, group=groupPrz)
lookbackH4       = input.int(30, "4H range lookback", minval=5, group=groupPrz)
lookbackH1       = input.int(60, "1H range lookback", minval=5, group=groupPrz)
swingPivotBars   = input.int(3, "Confirmed swing pivot bars", minval=2, maxval=10, group=groupPrz,
     tooltip="PRZ anchors remain fixed until a new pivot is confirmed on both sides.")
minimumCluster   = input.int(2, "Minimum overlapping PRZ levels", minval=1, maxval=3, group=groupPrz)
requireDeepSweep = input.bool(true, "Require 0.88 boundary sweep outside Asia", group=groupPrz)
sweepTtl         = input.int(8, "Sweep reclaim TTL (15m bars)", minval=1, maxval=40, group=groupPrz)
invalidationAtr  = input.float(0.15, "Beyond 1.00 invalidation buffer (ATR)", minval=0.0, step=0.05, group=groupPrz)
reclaimAtr       = input.float(0.25, "Reclaim overshoot allowance (ATR)", minval=0.0, step=0.05, group=groupPrz)

groupTrigger = "04. BB / PA / GC Futures RVOL Wall"
bbLen          = input.int(20, "BB length", minval=5, group=groupTrigger)
bbMult         = input.float(2.0, "BB deviation", minval=0.5, step=0.1, group=groupTrigger)
requireBbTouch = input.bool(true, "Require BB rejection", group=groupTrigger)
pinWickRatio   = input.float(2.0, "Pinbar wick/body ratio", minval=1.0, step=0.1, group=groupTrigger)
gcVolumeLen      = input.int(20, "GC contract-volume average", minval=5, group=groupTrigger)
requireGcRvolAtLevel = input.bool(true, "Require GC futures RVOL wall inside PRZ", group=groupTrigger,
     tooltip="Exchange-traded GC contract volume validates/arms the PRZ only. It never sends an entry by itself.")
gcRvolMin      = input.float(1.20, "GC minimum RVOL", minval=0.5, step=0.05, group=groupTrigger)
gcLevelAtrTolerance = input.float(0.35, "GC S/R proximity (ATR)", minval=0.05, step=0.05, group=groupTrigger)
entryMaxDistanceAtr = input.float(0.75, "Maximum HA confirmation distance from PRZ (ATR)", minval=0.1, step=0.05, group=groupTrigger,
     tooltip="Cancels an armed setup when the second HA candle forms in the middle between demand and supply.")
entryArmTtl    = input.int(8, "PRZ state TTL (15m bars)", minval=2, maxval=12, group=groupTrigger,
     tooltip="Keeps GC-RVOL wall evidence and confirmed PA alive while price remains in the PRZ, unless an opposite BOS invalidates the wall.")
tunnelTf = input.timeframe("60", "Parallel-channel anchor TF", group=groupTrigger,
     tooltip="Default H1. H4 remains PRZ/context; the channel is frozen between confirmed three-bar pivots, while only closed M15 bars may sweep or trigger it.")
tunnelSweepToleranceAtr = input.float(0.10, "Tunnel touch/sweep tolerance (ATR)", minval=0.0, step=0.05, group=groupTrigger)
tunnelEntryMaxDistanceAtr = input.float(2.0, "Maximum HA confirmation distance from tunnel (ATR)", minval=0.5, step=0.25, group=groupTrigger,
     tooltip="A tunnel touch/reclaim may arm a continuation approach, but the second HA15 candle must confirm before price travels too far from the swept boundary.")

groupStructure = "05. Structure Permission"
structureLookback     = input.int(5, "BOS / CHoCH lookback", minval=2, group=groupStructure)
requireAsymmetricH1   = input.bool(true, "Require BUY normal candle / SELL HA", group=groupStructure,
     tooltip="BUY permission uses a confirmed regular H1 bullish candle. SELL permission uses a confirmed H1 Heikin-Ashi bearish candle.")
requireStructureEntry = input.bool(false, "Require structure for entry", group=groupStructure)
requireStructureRun   = input.bool(true, "Require aligned structure to hold after BE", group=groupStructure)
exitOnStructureFlip   = input.bool(false, "Exit runner on opposite structure break", group=groupStructure)

groupRisk = "06. Virtual Trade Lifecycle"
slAtrBuffer    = input.float(0.20, "SL beyond sweep/cluster (ATR)", minval=0.0, step=0.05, group=groupRisk)
beAtR          = input.float(1.0, "Arm break-even at R", minval=0.25, step=0.25, group=groupRisk)
beOffsetTicks  = input.int(1, "BE offset (ticks)", minval=0, group=groupRisk)
tp2AtR         = input.float(3.0, "Runner hard target (R)", minval=1.0, step=0.25, group=groupRisk)
minimumPrzTargetR = input.float(1.25, "Minimum opposing PRZ target (R)", minval=1.0, step=0.25, group=groupRisk)
cooldownBars   = input.int(3, "Cooldown after exit (chart bars)", minval=0, group=groupRisk)

groupEa = "07. EA Signal Bridge"
webhookKey = input.string("", "API license key", group=groupEa,
     tooltip="Entered in TradingView settings. Never hard-code the key in this source file.")

groupVisual = "08. Visuals"
showDashboard = input.bool(true, "Show dashboard", group=groupVisual)
showHistoricalBands = input.bool(false, "Show rolling historical PRZ bands", group=groupVisual,
     tooltip="Keep disabled for clean fixed PRZ boxes. Historical bands move when confirmed HTF anchors update.")
showPrzBoxes  = input.bool(true, "Project PRZ target boxes", group=groupVisual)
projectionBars = input.int(60, "PRZ box projection bars", minval=10, maxval=300, group=groupVisual)
boxHistoryBars = input.int(48, "PRZ box bars to the left", minval=0, maxval=500, group=groupVisual)
showBb        = input.bool(false, "Show confirmed 15m BB", group=groupVisual)
showTunnel    = input.bool(true, "Show confirmed parallel channel", group=groupVisual)
showTrade     = input.bool(true, "Show entry / stop / targets", group=groupVisual)
showH1SourceDots = input.bool(true, "Show H1 BUY-candle / SELL-HA dots", group=groupVisual)

// =============================================================================
// 2. HELPERS
// =============================================================================

f_confirmed_swing_range(int _lookback, int _pivotBars) =>
    _pivotHigh = ta.pivothigh(high, _pivotBars, _pivotBars)
    _pivotLow = ta.pivotlow(low, _pivotBars, _pivotBars)
    _lastHigh = ta.valuewhen(not na(_pivotHigh), _pivotHigh, 0)
    _lastLow = ta.valuewhen(not na(_pivotLow), _pivotLow, 0)
    _fallbackHigh = ta.highest(high, _lookback)
    _fallbackLow = ta.lowest(low, _lookback)
    _rawHigh = na(_lastHigh) ? _fallbackHigh : _lastHigh
    _rawLow = na(_lastLow) ? _fallbackLow : _lastLow
    [math.max(_rawHigh, _rawLow)[1], math.min(_rawHigh, _rawLow)[1]]

f_confirmed_trigger(_bbLen, _bbMult) =>
    _basis = ta.sma(close, _bbLen)
    _dev = ta.stdev(close, _bbLen) * _bbMult
    _upper = _basis + _dev
    _lower = _basis - _dev
    _atr = ta.atr(14)
    [open[1], high[1], low[1], close[1], _basis[1], _upper[1], _lower[1], _atr[1], time_close[1]]

f_confirmed_gc(_volLen) =>
    _volAvg = ta.sma(volume, _volLen)
    _atr = ta.atr(14)
    [open[1], high[1], low[1], close[1], volume[1], _volAvg[1], _atr[1]]

f_confirmed_structure(_lookback) =>
    _bullBreak = close > ta.highest(high, _lookback)[1]
    _bearBreak = close < ta.lowest(low, _lookback)[1]
    [_bullBreak[1], _bearBreak[1]]

f_confirmed_parallel_channel(int _pivotBars) =>
    // A falling channel is anchored by two confirmed lower swing highs. Its
    // lower boundary is a same-slope parallel through the latest confirmed
    // swing low. A rising channel is the exact mirror. ta.pivot* appears only
    // after _pivotBars bars have closed, then the additional [1] freezes the
    // returned anchor set until a newer pivot is fully confirmed.
    _pivotHigh = ta.pivothigh(high, _pivotBars, _pivotBars)
    _pivotLow = ta.pivotlow(low, _pivotBars, _pivotBars)

    _high0 = ta.valuewhen(not na(_pivotHigh), _pivotHigh, 0)
    _high1 = ta.valuewhen(not na(_pivotHigh), _pivotHigh, 1)
    _highTime0 = ta.valuewhen(not na(_pivotHigh), time[_pivotBars], 0)
    _highTime1 = ta.valuewhen(not na(_pivotHigh), time[_pivotBars], 1)
    _low0 = ta.valuewhen(not na(_pivotLow), _pivotLow, 0)
    _low1 = ta.valuewhen(not na(_pivotLow), _pivotLow, 1)
    _lowTime0 = ta.valuewhen(not na(_pivotLow), time[_pivotBars], 0)
    _lowTime1 = ta.valuewhen(not na(_pivotLow), time[_pivotBars], 1)

    _haveHighs = not na(_high0) and not na(_high1) and not na(_highTime0) and not na(_highTime1) and _highTime0 > _highTime1
    _haveLows = not na(_low0) and not na(_low1) and not na(_lowTime0) and not na(_lowTime1) and _lowTime0 > _lowTime1
    _fallingStructure = _haveHighs and _haveLows and _high0 < _high1 and _low0 < _low1
    _risingStructure = _haveHighs and _haveLows and _high0 > _high1 and _low0 > _low1
    _channelAtr = ta.atr(14)

    float _highSlopePerMs = _haveHighs ? (_high0 - _high1) / float(_highTime0 - _highTime1) : na
    float _lowSlopePerMs = _haveLows ? (_low0 - _low1) / float(_lowTime0 - _lowTime1) : na
    int _direction = 0
    float _upper = na
    float _lower = na
    float _slopePerMs = na
    int _mainTime1 = na
    float _mainPrice1 = na
    int _mainTime2 = na
    float _mainPrice2 = na
    int _parallelTime = na
    float _parallelPrice = na
    int _anchorVersion = na

    if _fallingStructure
        _candidateUpper = _high0 + _highSlopePerMs * float(time_close - _highTime0)
        _candidateLower = _low0 + _highSlopePerMs * float(time_close - _lowTime0)
        if _candidateUpper > _candidateLower and _candidateUpper - _candidateLower >= _channelAtr * 0.50
            _direction := -1
            _upper := _candidateUpper
            _lower := _candidateLower
            _slopePerMs := _highSlopePerMs
            _mainTime1 := _highTime1
            _mainPrice1 := _high1
            _mainTime2 := _highTime0
            _mainPrice2 := _high0
            _parallelTime := _lowTime0
            _parallelPrice := _low0
            _anchorVersion := math.max(_highTime0, _lowTime0)
    else if _risingStructure
        _candidateLower = _low0 + _lowSlopePerMs * float(time_close - _lowTime0)
        _candidateUpper = _high0 + _lowSlopePerMs * float(time_close - _highTime0)
        if _candidateUpper > _candidateLower and _candidateUpper - _candidateLower >= _channelAtr * 0.50
            _direction := 1
            _upper := _candidateUpper
            _lower := _candidateLower
            _slopePerMs := _lowSlopePerMs
            _mainTime1 := _lowTime1
            _mainPrice1 := _low1
            _mainTime2 := _lowTime0
            _mainPrice2 := _low0
            _parallelTime := _highTime0
            _parallelPrice := _high0
            _anchorVersion := math.max(_lowTime0, _highTime0)

    [_direction[1], _upper[1], _lower[1], _slopePerMs[1], time_close[1], _mainTime1[1], _mainPrice1[1], _mainTime2[1], _mainPrice2[1], _parallelTime[1], _parallelPrice[1], _anchorVersion[1]]

f_buy_zone(_high, _low, _fibNear, _fibDeep) =>
    _width = math.max(_high - _low, syminfo.mintick)
    [_high - _width * _fibDeep, _high - _width * _fibNear]

f_sell_zone(_high, _low, _fibNear, _fibDeep) =>
    _width = math.max(_high - _low, syminfo.mintick)
    [_low + _width * _fibNear, _low + _width * _fibDeep]

f_overlap(_lo1, _hi1, _lo2, _hi2) =>
    not na(_lo1) and not na(_hi1) and not na(_lo2) and not na(_hi2) and math.max(_lo1, _lo2) <= math.min(_hi1, _hi2)

f_distance(_price, _lo, _hi) =>
    _price < _lo ? _lo - _price : _price > _hi ? _price - _hi : 0.0

f_target_above(_entry, _minimumDistance, _candidate1, _candidate2, _candidate3) =>
    float _target = na
    _threshold = _entry + _minimumDistance
    if not na(_candidate1) and _candidate1 >= _threshold
        _target := _candidate1
    if not na(_candidate2) and _candidate2 >= _threshold and (na(_target) or _candidate2 < _target)
        _target := _candidate2
    if not na(_candidate3) and _candidate3 >= _threshold and (na(_target) or _candidate3 < _target)
        _target := _candidate3
    _target

f_target_below(_entry, _minimumDistance, _candidate1, _candidate2, _candidate3) =>
    float _target = na
    _threshold = _entry - _minimumDistance
    if not na(_candidate1) and _candidate1 <= _threshold
        _target := _candidate1
    if not na(_candidate2) and _candidate2 <= _threshold and (na(_target) or _candidate2 > _target)
        _target := _candidate2
    if not na(_candidate3) and _candidate3 <= _threshold and (na(_target) or _candidate3 > _target)
        _target := _candidate3
    _target

f_num(float _value) =>
    na(_value) ? "null" : str.tostring(_value, "#.#####")

f_int(int _value) =>
    na(_value) ? "null" : str.tostring(_value)

f_tunnel_context_json(string _direction, string _timeframe, string _sweepEdge, float _upper, float _lower, float _tolerance, int _anchorTime1, float _anchorPrice1, int _anchorTime2, float _anchorPrice2, int _parallelTime, float _parallelPrice, int _anchorVersion) =>
    ',"tunnel_direction":"' + _direction + '","tunnel_timeframe":"' + _timeframe + '","tunnel_sweep_edge":"' + _sweepEdge + '","tunnel_upper":' + f_num(_upper) + ',"tunnel_lower":' + f_num(_lower) + ',"tunnel_atr_tolerance":' + f_num(_tolerance) + ',"tunnel_anchor_time_1":' + f_int(_anchorTime1) + ',"tunnel_anchor_price_1":' + f_num(_anchorPrice1) + ',"tunnel_anchor_time_2":' + f_int(_anchorTime2) + ',"tunnel_anchor_price_2":' + f_num(_anchorPrice2) + ',"tunnel_parallel_time":' + f_int(_parallelTime) + ',"tunnel_parallel_price":' + f_num(_parallelPrice) + ',"tunnel_anchor_version":' + f_int(_anchorVersion)

f_send_signal(string _action, string _direction, string _reason, float _entry, float _exit, float _sl, float _tp1, float _tp2, int _score, string _signalId, string _targetSource, string _contextJson) =>
    _payload = '{"key":"' + webhookKey + '","status":"SIGNAL","source":"PINE","strategy":"ALPHABUFF_V2_4","action":"' + _action + '","direction":"' + _direction + '","symbol":"' + syminfo.ticker + '","ticker_id":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","signal_id":"' + _signalId + '","entry_price":' + f_num(_entry) + ',"exit_price":' + f_num(_exit) + ',"sl_price":' + f_num(_sl) + ',"tp1_price":' + f_num(_tp1) + ',"tp2_price":' + f_num(_tp2) + ',"score":' + str.tostring(_score) + ',"target_source":"' + _targetSource + '","reason":"' + _reason + '"' + _contextJson + '}'
    alert(_payload, alert.freq_once_per_bar_close)

f_send_reverse_close(string _direction, string _reason, float _entry, float _exit, float _sl, float _tp1, float _tp2, int _score, string _signalId, string _targetSource, string _reverseDirection, float _reverseEntry, float _reverseSl, float _reverseTp1, float _reverseTp2, int _reverseScore, string _reverseSignalId, string _reverseTargetSource) =>
    _payload = '{"key":"' + webhookKey + '","status":"SIGNAL","source":"PINE","strategy":"ALPHABUFF_V2_4","action":"CLOSE","direction":"' + _direction + '","symbol":"' + syminfo.ticker + '","ticker_id":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","signal_id":"' + _signalId + '","entry_price":' + f_num(_entry) + ',"exit_price":' + f_num(_exit) + ',"sl_price":' + f_num(_sl) + ',"tp1_price":' + f_num(_tp1) + ',"tp2_price":' + f_num(_tp2) + ',"score":' + str.tostring(_score) + ',"target_source":"' + _targetSource + '","reason":"' + _reason + '","reverse_direction":"' + _reverseDirection + '","reverse_entry_price":' + f_num(_reverseEntry) + ',"reverse_sl_price":' + f_num(_reverseSl) + ',"reverse_tp1_price":' + f_num(_reverseTp1) + ',"reverse_tp2_price":' + f_num(_reverseTp2) + ',"reverse_score":' + str.tostring(_reverseScore) + ',"reverse_signal_id":"' + _reverseSignalId + '","reverse_target_source":"' + _reverseTargetSource + '","reverse_reason":"PRZ_GC_RVOL_WALL_PA_HA15_ACK_REVERSE"}'
    alert(_payload, alert.freq_once_per_bar_close)

// =============================================================================
// 3. CONFIRMED MULTI-TIMEFRAME DATA (NON-REPAINT)
// =============================================================================

[contextClose, contextEma, contextRsi, contextAtr] = request.security(
     syminfo.tickerid, contextTf,
     [close[1], ta.ema(close, emaLen)[1], ta.rsi(close, rsiLen)[1], ta.atr(14)[1]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

[dxyClose, dxyPrevious] = request.security(
     dxySymbol, contextTf, [close[1], close[2]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

[rangeHighD, rangeLowD] = request.security(
     syminfo.tickerid, rangeTfD, f_confirmed_swing_range(lookbackD, swingPivotBars),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

[rangeHighH4, rangeLowH4] = request.security(
     syminfo.tickerid, rangeTfH4, f_confirmed_swing_range(lookbackH4, swingPivotBars),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

[rangeHighH1, rangeLowH1] = request.security(
     syminfo.tickerid, rangeTfH1, f_confirmed_swing_range(lookbackH1, swingPivotBars),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

[triggerOpen, triggerHigh, triggerLow, triggerClose, bbBasis, bbUpper, bbLower, triggerAtr, triggerCloseTime] = request.security(
     syminfo.tickerid, triggerTf, f_confirmed_trigger(bbLen, bbMult),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

[tunnelDirection, tunnelBaseUpper, tunnelBaseLower, tunnelSlopePerMs, tunnelProjectionTime, tunnelMainTime1, tunnelMainPrice1, tunnelMainTime2, tunnelMainPrice2, tunnelParallelTime, tunnelParallelPrice, tunnelAnchorVersion] = request.security(
     syminfo.tickerid, tunnelTf, f_confirmed_parallel_channel(swingPivotBars),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

tunnelProjectionMs = not na(triggerCloseTime) and not na(tunnelProjectionTime) ? float(triggerCloseTime - tunnelProjectionTime) : 0.0
tunnelUpper = tunnelDirection == 0 or na(tunnelBaseUpper) or na(tunnelSlopePerMs) ? na : tunnelBaseUpper + tunnelSlopePerMs * tunnelProjectionMs
tunnelLower = tunnelDirection == 0 or na(tunnelBaseLower) or na(tunnelSlopePerMs) ? na : tunnelBaseLower + tunnelSlopePerMs * tunnelProjectionMs
tunnelMiddle = na(tunnelUpper) or na(tunnelLower) ? na : (tunnelUpper + tunnelLower) / 2.0

[gcOpen, gcHigh, gcLow, gcClose, gcVolume, gcVolAvg, gcAtr] = request.security(
     gcSymbol, triggerTf, f_confirmed_gc(gcVolumeLen),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[gcResistanceH1, gcSupportH1] = request.security(
     gcSymbol, rangeTfH1, f_confirmed_swing_range(lookbackH1, swingPivotBars),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

haTicker = ticker.heikinashi(syminfo.tickerid)
[ha15Open, ha15Close, ha15PrevOpen, ha15PrevClose] = request.security(
     haTicker, triggerTf, [open[1], close[1], open[2], close[2]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

[h1RegularOpen, h1RegularHigh, h1RegularLow, h1RegularClose] = request.security(
     syminfo.tickerid, entryConfirmTf, [open[1], high[1], low[1], close[1]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

[h1HaOpen, h1HaClose] = request.security(
     haTicker, entryConfirmTf, [open[1], close[1]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

[bullStructureBreak, bearStructureBreak] = request.security(
     syminfo.tickerid, structureTf, f_confirmed_structure(structureLookback),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// =============================================================================
// 4. SESSION-AWARE FIBONACCI PRZ CLUSTERS
// =============================================================================

marketOpen = not na(time(timeframe.period, marketSession, marketTimezone)) and (not requireExchangeMarket or session.ismarket)
isAsia = not na(time(timeframe.period, asiaSession, marketTimezone))
selectedFibA = isAsia ? asiaFibMin : deepFibMin
selectedFibB = isAsia ? asiaFibMax : deepFibMax
fibNear = math.min(selectedFibA, selectedFibB)
fibDeep = math.max(selectedFibA, selectedFibB)

[buyDLo, buyDHi] = f_buy_zone(rangeHighD, rangeLowD, fibNear, fibDeep)
[buyH4Lo, buyH4Hi] = f_buy_zone(rangeHighH4, rangeLowH4, fibNear, fibDeep)
[buyH1Lo, buyH1Hi] = f_buy_zone(rangeHighH1, rangeLowH1, fibNear, fibDeep)

[sellDLo, sellDHi] = f_sell_zone(rangeHighD, rangeLowD, fibNear, fibDeep)
[sellH4Lo, sellH4Hi] = f_sell_zone(rangeHighH4, rangeLowH4, fibNear, fibDeep)
[sellH1Lo, sellH1Hi] = f_sell_zone(rangeHighH1, rangeLowH1, fibNear, fibDeep)

buyOverlapDH4 = f_overlap(buyDLo, buyDHi, buyH4Lo, buyH4Hi)
buyOverlapDH1 = f_overlap(buyDLo, buyDHi, buyH1Lo, buyH1Hi)
buyOverlapH4H1 = f_overlap(buyH4Lo, buyH4Hi, buyH1Lo, buyH1Hi)

sellOverlapDH4 = f_overlap(sellDLo, sellDHi, sellH4Lo, sellH4Hi)
sellOverlapDH1 = f_overlap(sellDLo, sellDHi, sellH1Lo, sellH1Hi)
sellOverlapH4H1 = f_overlap(sellH4Lo, sellH4Hi, sellH1Lo, sellH1Hi)

// TF weights: D=3, H4=2, H1=1. A D+H4 overlap therefore produces Score 5.
buyScoreD = 3 + (buyOverlapDH4 ? 2 : 0) + (buyOverlapDH1 ? 1 : 0)
buyScoreH4 = 2 + (buyOverlapDH4 ? 3 : 0) + (buyOverlapH4H1 ? 1 : 0)
buyScoreH1 = 1 + (buyOverlapDH1 ? 3 : 0) + (buyOverlapH4H1 ? 2 : 0)

sellScoreD = 3 + (sellOverlapDH4 ? 2 : 0) + (sellOverlapDH1 ? 1 : 0)
sellScoreH4 = 2 + (sellOverlapDH4 ? 3 : 0) + (sellOverlapH4H1 ? 1 : 0)
sellScoreH1 = 1 + (sellOverlapDH1 ? 3 : 0) + (sellOverlapH4H1 ? 2 : 0)

int buyChoice = 0
int buyClusterScore = buyScoreD
float buyBestDistance = f_distance(close, buyDLo, buyDHi)
if buyScoreH4 > buyClusterScore or (buyScoreH4 == buyClusterScore and f_distance(close, buyH4Lo, buyH4Hi) < buyBestDistance)
    buyChoice := 1
    buyClusterScore := buyScoreH4
    buyBestDistance := f_distance(close, buyH4Lo, buyH4Hi)
if buyScoreH1 > buyClusterScore or (buyScoreH1 == buyClusterScore and f_distance(close, buyH1Lo, buyH1Hi) < buyBestDistance)
    buyChoice := 2
    buyClusterScore := buyScoreH1
    buyBestDistance := f_distance(close, buyH1Lo, buyH1Hi)

float buyClusterLo = buyChoice == 0 ? buyDLo : buyChoice == 1 ? buyH4Lo : buyH1Lo
float buyClusterHi = buyChoice == 0 ? buyDHi : buyChoice == 1 ? buyH4Hi : buyH1Hi
float buyExtreme = buyChoice == 0 ? rangeLowD : buyChoice == 1 ? rangeLowH4 : rangeLowH1
int buyClusterCount = buyChoice == 0 ? 1 + (buyOverlapDH4 ? 1 : 0) + (buyOverlapDH1 ? 1 : 0) : buyChoice == 1 ? 1 + (buyOverlapDH4 ? 1 : 0) + (buyOverlapH4H1 ? 1 : 0) : 1 + (buyOverlapDH1 ? 1 : 0) + (buyOverlapH4H1 ? 1 : 0)

if buyChoice == 0
    if buyOverlapDH4
        buyClusterLo := math.min(buyClusterLo, buyH4Lo)
        buyClusterHi := math.max(buyClusterHi, buyH4Hi)
    if buyOverlapDH1
        buyClusterLo := math.min(buyClusterLo, buyH1Lo)
        buyClusterHi := math.max(buyClusterHi, buyH1Hi)
else if buyChoice == 1
    if buyOverlapDH4
        buyClusterLo := math.min(buyClusterLo, buyDLo)
        buyClusterHi := math.max(buyClusterHi, buyDHi)
    if buyOverlapH4H1
        buyClusterLo := math.min(buyClusterLo, buyH1Lo)
        buyClusterHi := math.max(buyClusterHi, buyH1Hi)
else
    if buyOverlapDH1
        buyClusterLo := math.min(buyClusterLo, buyDLo)
        buyClusterHi := math.max(buyClusterHi, buyDHi)
    if buyOverlapH4H1
        buyClusterLo := math.min(buyClusterLo, buyH4Lo)
        buyClusterHi := math.max(buyClusterHi, buyH4Hi)

int sellChoice = 0
int sellClusterScore = sellScoreD
float sellBestDistance = f_distance(close, sellDLo, sellDHi)
if sellScoreH4 > sellClusterScore or (sellScoreH4 == sellClusterScore and f_distance(close, sellH4Lo, sellH4Hi) < sellBestDistance)
    sellChoice := 1
    sellClusterScore := sellScoreH4
    sellBestDistance := f_distance(close, sellH4Lo, sellH4Hi)
if sellScoreH1 > sellClusterScore or (sellScoreH1 == sellClusterScore and f_distance(close, sellH1Lo, sellH1Hi) < sellBestDistance)
    sellChoice := 2
    sellClusterScore := sellScoreH1
    sellBestDistance := f_distance(close, sellH1Lo, sellH1Hi)

float sellClusterLo = sellChoice == 0 ? sellDLo : sellChoice == 1 ? sellH4Lo : sellH1Lo
float sellClusterHi = sellChoice == 0 ? sellDHi : sellChoice == 1 ? sellH4Hi : sellH1Hi
float sellExtreme = sellChoice == 0 ? rangeHighD : sellChoice == 1 ? rangeHighH4 : rangeHighH1
int sellClusterCount = sellChoice == 0 ? 1 + (sellOverlapDH4 ? 1 : 0) + (sellOverlapDH1 ? 1 : 0) : sellChoice == 1 ? 1 + (sellOverlapDH4 ? 1 : 0) + (sellOverlapH4H1 ? 1 : 0) : 1 + (sellOverlapDH1 ? 1 : 0) + (sellOverlapH4H1 ? 1 : 0)

if sellChoice == 0
    if sellOverlapDH4
        sellClusterLo := math.min(sellClusterLo, sellH4Lo)
        sellClusterHi := math.max(sellClusterHi, sellH4Hi)
    if sellOverlapDH1
        sellClusterLo := math.min(sellClusterLo, sellH1Lo)
        sellClusterHi := math.max(sellClusterHi, sellH1Hi)
else if sellChoice == 1
    if sellOverlapDH4
        sellClusterLo := math.min(sellClusterLo, sellDLo)
        sellClusterHi := math.max(sellClusterHi, sellDHi)
    if sellOverlapH4H1
        sellClusterLo := math.min(sellClusterLo, sellH1Lo)
        sellClusterHi := math.max(sellClusterHi, sellH1Hi)
else
    if sellOverlapDH1
        sellClusterLo := math.min(sellClusterLo, sellDLo)
        sellClusterHi := math.max(sellClusterHi, sellDHi)
    if sellOverlapH4H1
        sellClusterLo := math.min(sellClusterLo, sellH4Lo)
        sellClusterHi := math.max(sellClusterHi, sellH4Hi)

// =============================================================================
// 5. DIRECTIONAL CONTEXT, PA / BB, GC FUTURES RVOL WALL, AND STRUCTURE
// =============================================================================

emaBuy = contextClose > contextEma
emaSell = contextClose < contextEma
rsiBuy = contextRsi > 50.0
rsiSell = contextRsi < 50.0
dxyBuy = dxyClose < dxyPrevious
dxySell = dxyClose > dxyPrevious

buyContextScore = (emaBuy ? 1 : 0) + (rsiBuy ? 1 : 0) + (dxyBuy ? 1 : 0)
sellContextScore = (emaSell ? 1 : 0) + (rsiSell ? 1 : 0) + (dxySell ? 1 : 0)
buyContextOk = buyContextScore >= contextThreshold
sellContextOk = sellContextScore >= contextThreshold

triggerBody = math.max(math.abs(triggerClose - triggerOpen), syminfo.mintick)
lowerWick = math.min(triggerOpen, triggerClose) - triggerLow
upperWick = triggerHigh - math.max(triggerOpen, triggerClose)

bullPin = lowerWick >= triggerBody * pinWickRatio and upperWick <= triggerBody
bearPin = upperWick >= triggerBody * pinWickRatio and lowerWick <= triggerBody
gcHasData = not na(gcClose) and not na(gcVolume) and not na(gcVolAvg) and gcVolAvg > 0 and not na(gcAtr)
gcRvol = gcHasData ? gcVolume / gcVolAvg : na
gcLevelTolerance = gcHasData ? math.max(gcAtr * gcLevelAtrTolerance, syminfo.mintick) : na
gcAtSupport = gcHasData and not na(gcSupportH1) and gcLow <= gcSupportH1 + gcLevelTolerance and gcHigh >= gcSupportH1 - gcLevelTolerance
gcAtResistance = gcHasData and not na(gcResistanceH1) and gcHigh >= gcResistanceH1 - gcLevelTolerance and gcLow <= gcResistanceH1 + gcLevelTolerance
gcBuyRvolWall = gcAtSupport and gcRvol >= gcRvolMin and gcClose >= gcOpen
gcSellRvolWall = gcAtResistance and gcRvol >= gcRvolMin and gcClose <= gcOpen
gcBuyPermission = not requireGcRvolAtLevel or gcBuyRvolWall
gcSellPermission = not requireGcRvolAtLevel or gcSellRvolWall

bbBuyReject = triggerLow <= bbLower and triggerClose > bbLower
bbSellReject = triggerHigh >= bbUpper and triggerClose < bbUpper
buyBbOk = not requireBbTouch or bbBuyReject
sellBbOk = not requireBbTouch or bbSellReject
buyH1NormalCandle = h1RegularClose > h1RegularOpen
sellH1HeikinAshi = h1HaClose < h1HaOpen
h1Range = math.max(h1RegularHigh - h1RegularLow, syminfo.mintick)
h1Body = math.max(math.abs(h1RegularClose - h1RegularOpen), syminfo.mintick)
h1LowerWick = math.min(h1RegularOpen, h1RegularClose) - h1RegularLow
h1UpperWick = h1RegularHigh - math.max(h1RegularOpen, h1RegularClose)
h1BullPin = h1LowerWick >= h1Body * pinWickRatio and h1UpperWick <= h1Body
h1BearPin = h1UpperWick >= h1Body * pinWickRatio and h1LowerWick <= h1Body
buyReversalPin = bullPin or h1BullPin
sellReversalPin = bearPin or h1BearPin
buyH1Permission = not requireAsymmetricH1 or buyH1NormalCandle
sellH1Permission = not requireAsymmetricH1 or sellH1HeikinAshi

newTriggerBar = timeframe.change(triggerTf)
newStructureBar = timeframe.change(structureTf)
newEntryConfirmBar = timeframe.change(entryConfirmTf)

var int structureBias = 0
var string structureEvent = "NONE"
// A confirmed H1 anchor set stays frozen, but it must never remain executable
// after a closed M15 candle breaks the opposite boundary or a confirmed H1 BOS
// breaks against it. The invalidation is tied to the anchor version, so a new
// fully confirmed pivot set can create the next channel without repainting.
var int invalidatedTunnelAnchorVersion = na
if barstate.isconfirmed and newStructureBar
    if bullStructureBreak
        structureEvent := structureBias == -1 ? "BULL CHoCH" : structureBias == 1 ? "BULL BOS" : "BULL BREAK"
        structureBias := 1
    else if bearStructureBreak
        structureEvent := structureBias == 1 ? "BEAR CHoCH" : structureBias == -1 ? "BEAR BOS" : "BEAR BREAK"
        structureBias := -1

tunnelBreakBuffer = triggerAtr * tunnelSweepToleranceAtr
risingTunnelBoundaryBreak = tunnelDirection == 1 and not na(tunnelLower) and triggerClose < tunnelLower - tunnelBreakBuffer
fallingTunnelBoundaryBreak = tunnelDirection == -1 and not na(tunnelUpper) and triggerClose > tunnelUpper + tunnelBreakBuffer
risingTunnelBosBreak = tunnelDirection == 1 and newStructureBar and bearStructureBreak
fallingTunnelBosBreak = tunnelDirection == -1 and newStructureBar and bullStructureBreak
if barstate.isconfirmed and not na(tunnelAnchorVersion)
    if (newTriggerBar and risingTunnelBoundaryBreak) or risingTunnelBosBreak
        invalidatedTunnelAnchorVersion := tunnelAnchorVersion
    else if (newTriggerBar and fallingTunnelBoundaryBreak) or fallingTunnelBosBreak
        invalidatedTunnelAnchorVersion := tunnelAnchorVersion

tunnelAnchorActive = tunnelDirection != 0 and not na(tunnelAnchorVersion) and tunnelAnchorVersion != invalidatedTunnelAnchorVersion
activeTunnelDirection = tunnelAnchorActive ? tunnelDirection : 0
activeTunnelUpper = tunnelAnchorActive ? tunnelUpper : na
activeTunnelLower = tunnelAnchorActive ? tunnelLower : na
activeTunnelMiddle = tunnelAnchorActive ? tunnelMiddle : na
tunnelDirectionText = activeTunnelDirection == 1 ? "RISING" : activeTunnelDirection == -1 ? "FALLING" : "NONE"

// =============================================================================
// 6. SWEEP -> RECLAIM STATE
// =============================================================================

var bool buySweepArmed = false
var bool sellSweepArmed = false
var float buySweepLow = na
var float sellSweepHigh = na
var int buySweepAge = 0
var int sellSweepAge = 0
// GC futures RVOL is evidence attached to the PRZ, never an entry trigger.
var bool buyGcRvolWallArmed = false
var bool sellGcRvolWallArmed = false
var int buyGcRvolWallAge = 0
var int sellGcRvolWallAge = 0
var bool buyPaZoneArmed = false
var bool sellPaZoneArmed = false
var int buyPaZoneAge = 0
var int sellPaZoneAge = 0
var bool buyEntryArmed = false
var bool sellEntryArmed = false
var int buyEntryArmAge = 0
var int sellEntryArmAge = 0
var bool buyTunnelSweepArmed = false
var bool sellTunnelSweepArmed = false
var int buyTunnelSweepAge = 0
var int sellTunnelSweepAge = 0
var float buyTunnelSweepLevel = na
var float sellTunnelSweepLevel = na
var float buyTunnelSweepLow = na
var float sellTunnelSweepHigh = na
var int buyTunnelAnchorVersion = na
var int sellTunnelAnchorVersion = na
var bool buyEntryFromTunnel = false
var bool sellEntryFromTunnel = false
var bool previousAsia = isAsia

var int tradeDirection = 0
var int cooldown = 0

if barstate.isconfirmed and cooldown > 0
    cooldown -= 1

if isAsia != previousAsia
    buySweepArmed := false
    sellSweepArmed := false
    buySweepLow := na
    sellSweepHigh := na
    buySweepAge := 0
    sellSweepAge := 0
    buyGcRvolWallArmed := false
    sellGcRvolWallArmed := false
    buyGcRvolWallAge := 0
    sellGcRvolWallAge := 0
    buyPaZoneArmed := false
    sellPaZoneArmed := false
    buyPaZoneAge := 0
    sellPaZoneAge := 0
    buyEntryArmed := false
    sellEntryArmed := false
    buyEntryArmAge := 0
    sellEntryArmAge := 0
    buyTunnelSweepArmed := false
    sellTunnelSweepArmed := false
    buyTunnelSweepAge := 0
    sellTunnelSweepAge := 0
    buyTunnelSweepLevel := na
    sellTunnelSweepLevel := na
    buyTunnelSweepLow := na
    sellTunnelSweepHigh := na
    buyTunnelAnchorVersion := na
    sellTunnelAnchorVersion := na
    buyEntryFromTunnel := false
    sellEntryFromTunnel := false
    previousAsia := isAsia

bool buyReclaimNow = false
bool sellReclaimNow = false
bool buyTunnelSweepNow = false
bool sellTunnelSweepNow = false

if barstate.isconfirmed and newTriggerBar
    if buySweepArmed
        buySweepAge += 1
        buySweepLow := math.min(buySweepLow, triggerLow)
    if sellSweepArmed
        sellSweepAge += 1
        sellSweepHigh := math.max(sellSweepHigh, triggerHigh)
    if buyTunnelSweepArmed
        buyTunnelSweepAge += 1
        buyTunnelSweepLow := math.min(buyTunnelSweepLow, triggerLow)
    if sellTunnelSweepArmed
        sellTunnelSweepAge += 1
        sellTunnelSweepHigh := math.max(sellTunnelSweepHigh, triggerHigh)

    buyInvalid = triggerLow < buyExtreme - triggerAtr * invalidationAtr
    sellInvalid = triggerHigh > sellExtreme + triggerAtr * invalidationAtr

    if buyInvalid or buySweepAge > sweepTtl
        buySweepArmed := false
        buySweepLow := na
        buySweepAge := 0
    if sellInvalid or sellSweepAge > sweepTtl
        sellSweepArmed := false
        sellSweepHigh := na
        sellSweepAge := 0

    tunnelTouchBuffer = triggerAtr * tunnelSweepToleranceAtr
    confirmedRisingTunnel = activeTunnelDirection == 1 and not na(activeTunnelUpper) and not na(activeTunnelLower)
    confirmedFallingTunnel = activeTunnelDirection == -1 and not na(activeTunnelUpper) and not na(activeTunnelLower)
    buyTunnelSweepNow := confirmedRisingTunnel and triggerLow <= activeTunnelLower + tunnelTouchBuffer and triggerClose > activeTunnelLower
    sellTunnelSweepNow := confirmedFallingTunnel and triggerHigh >= activeTunnelUpper - tunnelTouchBuffer and triggerClose < activeTunnelUpper

    buyTunnelChanged = buyTunnelSweepArmed and not na(buyTunnelAnchorVersion) and tunnelAnchorVersion != buyTunnelAnchorVersion
    sellTunnelChanged = sellTunnelSweepArmed and not na(sellTunnelAnchorVersion) and tunnelAnchorVersion != sellTunnelAnchorVersion
    if buyTunnelSweepArmed and (buyTunnelSweepAge > entryArmTtl or triggerClose < buyTunnelSweepLevel - triggerAtr * reclaimAtr or activeTunnelDirection != 1 or buyTunnelChanged)
        buyTunnelSweepArmed := false
        buyTunnelSweepAge := 0
        buyTunnelSweepLevel := na
        buyTunnelSweepLow := na
        buyTunnelAnchorVersion := na
    if sellTunnelSweepArmed and (sellTunnelSweepAge > entryArmTtl or triggerClose > sellTunnelSweepLevel + triggerAtr * reclaimAtr or activeTunnelDirection != -1 or sellTunnelChanged)
        sellTunnelSweepArmed := false
        sellTunnelSweepAge := 0
        sellTunnelSweepLevel := na
        sellTunnelSweepHigh := na
        sellTunnelAnchorVersion := na

    if buyTunnelSweepNow
        buyTunnelSweepArmed := true
        buyTunnelSweepAge := 0
        buyTunnelSweepLevel := activeTunnelLower
        buyTunnelSweepLow := na(buyTunnelSweepLow) ? triggerLow : math.min(buyTunnelSweepLow, triggerLow)
        buyTunnelAnchorVersion := tunnelAnchorVersion
    if sellTunnelSweepNow
        sellTunnelSweepArmed := true
        sellTunnelSweepAge := 0
        sellTunnelSweepLevel := activeTunnelUpper
        sellTunnelSweepHigh := na(sellTunnelSweepHigh) ? triggerHigh : math.max(sellTunnelSweepHigh, triggerHigh)
        sellTunnelAnchorVersion := tunnelAnchorVersion

    buySweepCandidate = triggerLow < buyClusterLo and triggerLow >= buyExtreme - triggerAtr * invalidationAtr
    sellSweepCandidate = triggerHigh > sellClusterHi and triggerHigh <= sellExtreme + triggerAtr * invalidationAtr

    if buySweepCandidate
        buySweepArmed := true
        buySweepLow := na(buySweepLow) ? triggerLow : math.min(buySweepLow, triggerLow)
        buySweepAge := 0
    if sellSweepCandidate
        sellSweepArmed := true
        sellSweepHigh := na(sellSweepHigh) ? triggerHigh : math.max(sellSweepHigh, triggerHigh)
        sellSweepAge := 0

    buyReclaimNow := buySweepArmed and triggerClose >= buyClusterLo and triggerClose <= buyClusterHi + triggerAtr * reclaimAtr
    sellReclaimNow := sellSweepArmed and triggerClose <= sellClusterHi and triggerClose >= sellClusterLo - triggerAtr * reclaimAtr

buyClusterTouch = triggerLow <= buyClusterHi and triggerHigh >= buyClusterLo
sellClusterTouch = triggerHigh >= sellClusterLo and triggerLow <= sellClusterHi

entryDistanceBuffer = triggerAtr * entryMaxDistanceAtr
buyDecisionZone = triggerClose >= buyClusterLo - triggerAtr * reclaimAtr and triggerClose <= buyClusterHi + entryDistanceBuffer
sellDecisionZone = triggerClose <= sellClusterHi + triggerAtr * reclaimAtr and triggerClose >= sellClusterLo - entryDistanceBuffer
buyDirectionalZone = buyDecisionZone and not sellDecisionZone
sellDirectionalZone = sellDecisionZone and not buyDecisionZone
middleLocation = not buyDecisionZone and not sellDecisionZone
ambiguousLocation = buyDecisionZone and sellDecisionZone

buyLocationOk = (isAsia or not requireDeepSweep) ? buyClusterTouch : buyReclaimNow
sellLocationOk = (isAsia or not requireDeepSweep) ? sellClusterTouch : sellReclaimNow
buyClusterOk = buyClusterCount >= minimumCluster
sellClusterOk = sellClusterCount >= minimumCluster
buyTunnelLocationOk = buyTunnelSweepArmed and not na(buyTunnelSweepLevel) and triggerClose >= buyTunnelSweepLevel - triggerAtr * reclaimAtr and triggerClose <= buyTunnelSweepLevel + triggerAtr * tunnelEntryMaxDistanceAtr
sellTunnelLocationOk = sellTunnelSweepArmed and not na(sellTunnelSweepLevel) and triggerClose <= sellTunnelSweepLevel + triggerAtr * reclaimAtr and triggerClose >= sellTunnelSweepLevel - triggerAtr * tunnelEntryMaxDistanceAtr
buyPrzRouteOk = buyClusterOk and buyLocationOk and buyDirectionalZone
sellPrzRouteOk = sellClusterOk and sellLocationOk and sellDirectionalZone
buyEvidenceLocationOk = buyPrzRouteOk or buyTunnelLocationOk
sellEvidenceLocationOk = sellPrzRouteOk or sellTunnelLocationOk

chartSeconds = timeframe.in_seconds()
triggerSeconds = timeframe.in_seconds(triggerTf)
structureSeconds = timeframe.in_seconds(structureTf)
entryConfirmSeconds = timeframe.in_seconds(entryConfirmTf)
contextSeconds = timeframe.in_seconds(contextTf)
rangeDSeconds = timeframe.in_seconds(rangeTfD)
rangeH4Seconds = timeframe.in_seconds(rangeTfH4)
rangeH1Seconds = timeframe.in_seconds(rangeTfH1)
tunnelSeconds = timeframe.in_seconds(tunnelTf)
safeTimeframe = chartSeconds <= triggerSeconds and chartSeconds <= structureSeconds and chartSeconds <= entryConfirmSeconds and chartSeconds <= contextSeconds and chartSeconds <= rangeDSeconds and chartSeconds <= rangeH4Seconds and chartSeconds <= rangeH1Seconds and chartSeconds <= tunnelSeconds
timeframeGate = not enforceSafeTf or safeTimeframe
buyStructureEntryOk = not requireStructureEntry or structureBias == 1
sellStructureEntryOk = not requireStructureEntry or structureBias == -1

buyPrzBosThrough = newStructureBar and bearStructureBreak
sellPrzBosThrough = newStructureBar and bullStructureBreak

// GC contract RVOL validates the PRZ location. It cannot arm an executable entry.
buyGcRvolWallSetup = marketOpen and timeframeGate and buyEvidenceLocationOk and gcBuyPermission and not buyPrzBosThrough
sellGcRvolWallSetup = marketOpen and timeframeGate and sellEvidenceLocationOk and gcSellPermission and not sellPrzBosThrough

// GC RVOL wall and PA are two properties of the same PRZ. Either may appear first;
// neither can enter. Only the completed evidence latch may wait for HA15 #2.
buyPaZoneSetup = marketOpen and timeframeGate and buyContextOk and buyEvidenceLocationOk and buyBbOk and buyReversalPin and buyH1Permission and buyStructureEntryOk and not buyPrzBosThrough
sellPaZoneSetup = marketOpen and timeframeGate and sellContextOk and sellEvidenceLocationOk and sellBbOk and sellReversalPin and sellH1Permission and sellStructureEntryOk and not sellPrzBosThrough
buyArmSetup = (buyGcRvolWallArmed or buyGcRvolWallSetup) and (buyPaZoneArmed or buyPaZoneSetup)
sellArmSetup = (sellGcRvolWallArmed or sellGcRvolWallSetup) and (sellPaZoneArmed or sellPaZoneSetup)

buyActiveEntryLocationOk = buyEntryFromTunnel ? buyTunnelLocationOk : buyDirectionalZone
sellActiveEntryLocationOk = sellEntryFromTunnel ? sellTunnelLocationOk : sellDirectionalZone
buyPrzConfirmationPermission = marketOpen and timeframeGate and buyContextOk and buyActiveEntryLocationOk and buyH1Permission and buyStructureEntryOk and not buyPrzBosThrough
sellPrzConfirmationPermission = marketOpen and timeframeGate and sellContextOk and sellActiveEntryLocationOk and sellH1Permission and sellStructureEntryOk and not sellPrzBosThrough
buyConfirmationPermission = buyPrzConfirmationPermission
sellConfirmationPermission = sellPrzConfirmationPermission

// The second confirmed HA candle must close beyond the whole body of the first.
// Minute 10 may be displayed as a forming candidate, but no EA command is sent
// before the 15m candle closes; this preserves the non-repaint contract.
ha15TwoBullHigher = ha15Close > ha15Open and ha15PrevClose > ha15PrevOpen and ha15Close > math.max(ha15PrevOpen, ha15PrevClose)
ha15TwoBearLower = ha15Close < ha15Open and ha15PrevClose < ha15PrevOpen and ha15Close < math.min(ha15PrevOpen, ha15PrevClose)

bool buyEntryConfirmed = false
bool sellEntryConfirmed = false
if barstate.isconfirmed and newTriggerBar
    if buyGcRvolWallArmed
        buyGcRvolWallAge += 1
        if buyGcRvolWallAge > entryArmTtl or not buyEvidenceLocationOk
            buyGcRvolWallArmed := false
            buyGcRvolWallAge := 0
    if sellGcRvolWallArmed
        sellGcRvolWallAge += 1
        if sellGcRvolWallAge > entryArmTtl or not sellEvidenceLocationOk
            sellGcRvolWallArmed := false
            sellGcRvolWallAge := 0
    if buyPaZoneArmed
        buyPaZoneAge += 1
        if buyPaZoneAge > entryArmTtl or not buyEvidenceLocationOk
            buyPaZoneArmed := false
            buyPaZoneAge := 0
    if sellPaZoneArmed
        sellPaZoneAge += 1
        if sellPaZoneAge > entryArmTtl or not sellEvidenceLocationOk
            sellPaZoneArmed := false
            sellPaZoneAge := 0

    if buyPrzBosThrough
        buyGcRvolWallArmed := false
        buyGcRvolWallAge := 0
        buyPaZoneArmed := false
        buyPaZoneAge := 0
        buyEntryArmed := false
        buyEntryArmAge := 0
        buyEntryFromTunnel := false
        buyTunnelSweepArmed := false
        buyTunnelSweepAge := 0
        buyTunnelSweepLevel := na
        buyTunnelSweepLow := na
        buyTunnelAnchorVersion := na
    if sellPrzBosThrough
        sellGcRvolWallArmed := false
        sellGcRvolWallAge := 0
        sellPaZoneArmed := false
        sellPaZoneAge := 0
        sellEntryArmed := false
        sellEntryArmAge := 0
        sellEntryFromTunnel := false
        sellTunnelSweepArmed := false
        sellTunnelSweepAge := 0
        sellTunnelSweepLevel := na
        sellTunnelSweepHigh := na
        sellTunnelAnchorVersion := na

    if buyGcRvolWallSetup
        buyGcRvolWallArmed := true
        buyGcRvolWallAge := 0
    if sellGcRvolWallSetup
        sellGcRvolWallArmed := true
        sellGcRvolWallAge := 0
    if buyPaZoneSetup
        buyPaZoneArmed := true
        buyPaZoneAge := 0
    if sellPaZoneSetup
        sellPaZoneArmed := true
        sellPaZoneAge := 0

    if buyEntryArmed
        buyEntryArmAge += 1
        if buyEntryArmAge > entryArmTtl or not buyActiveEntryLocationOk
            buyEntryArmed := false
            buyEntryArmAge := 0
            buyEntryFromTunnel := false
    if sellEntryArmed
        sellEntryArmAge += 1
        if sellEntryArmAge > entryArmTtl or not sellActiveEntryLocationOk
            sellEntryArmed := false
            sellEntryArmAge := 0
            sellEntryFromTunnel := false

    // Confirmation uses a location that was armed on an earlier confirmed bar.
    buyEntryConfirmed := buyEntryArmed and ha15TwoBullHigher and buyConfirmationPermission
    sellEntryConfirmed := sellEntryArmed and ha15TwoBearLower and sellConfirmationPermission

    if buyEntryConfirmed
        buyEntryArmed := false
        buyEntryArmAge := 0
    else if buyArmSetup
        buyEntryArmed := true
        buyEntryArmAge := 0
        buyEntryFromTunnel := not buyPrzRouteOk and buyTunnelLocationOk
        buyGcRvolWallArmed := false
        buyGcRvolWallAge := 0
        buyPaZoneArmed := false
        buyPaZoneAge := 0

    if sellEntryConfirmed
        sellEntryArmed := false
        sellEntryArmAge := 0
    else if sellArmSetup
        sellEntryArmed := true
        sellEntryArmAge := 0
        sellEntryFromTunnel := not sellPrzRouteOk and sellTunnelLocationOk
        sellGcRvolWallArmed := false
        sellGcRvolWallAge := 0
        sellPaZoneArmed := false
        sellPaZoneAge := 0

// =============================================================================
// 7. SIGNAL AND VIRTUAL TRADE LIFECYCLE
// =============================================================================

var float tradeEntry = na
var float tradeInitialStop = na
var float tradeRisk = na
var float tradeBeTrigger = na
var float tradeTp2 = na
var string tradeTargetSource = "NONE"
var string tradeSignalId = ""
var int tradeScore = 0
var bool breakEvenArmed = false
var bool runnerActive = false
var int entryBar = na
var string lifecycle = "WAIT_LOCATION"

bool buySignal = false
bool sellSignal = false
bool exitSignal = false
string exitReason = ""
string exitedDirection = "NONE"
float exitPrice = na
float noExitPrice = na
string reverseDirection = "NONE"
float reverseEntry = na
float reverseSl = na
float reverseRisk = na
float reverseTp1 = na
float reverseTp2 = na
int reverseScore = 0
string reverseSignalId = ""
string reverseTargetSource = "NONE"

if barstate.isconfirmed and newTriggerBar and tradeDirection == 0 and cooldown == 0
    if buyEntryConfirmed and not sellEntryConfirmed
        buySignal := true
        tradeDirection := 1
        tradeEntry := close
        stopAnchor = buyEntryFromTunnel ? math.min(buyTunnelSweepLevel, buyTunnelSweepLow) : math.min(buyClusterLo, na(buySweepLow) ? buyClusterLo : buySweepLow)
        tradeInitialStop := stopAnchor - triggerAtr * slAtrBuffer
        tradeRisk := math.max(tradeEntry - tradeInitialStop, syminfo.mintick)
        tradeBeTrigger := tradeEntry + tradeRisk * beAtR
        przTarget = f_target_above(tradeEntry, tradeRisk * minimumPrzTargetR, sellDLo, sellH4Lo, sellH1Lo)
        tradeTp2 := na(przTarget) ? tradeEntry + tradeRisk * tp2AtR : przTarget
        tradeTargetSource := na(przTarget) ? "R_FALLBACK" : "SUPPLY_PRZ"
        tradeSignalId := str.replace_all(str.replace_all(syminfo.ticker + "-" + str.tostring(time_close) + "-BUY", ":", ""), "/", "")
        tradeScore := buyClusterScore
        breakEvenArmed := false
        runnerActive := false
        entryBar := bar_index
        lifecycle := "OPEN_BUY"
        if marketOpen
            buyEntryReason = buyEntryFromTunnel ? "TUNNEL_SWEEP_GC_RVOL_WALL_PA_HA15_BUY" : "PRZ_GC_RVOL_WALL_PA_HA15_BUY"
            buyTunnelContext = f_tunnel_context_json(tunnelDirectionText, tunnelTf, buyEntryFromTunnel ? "LOWER" : "NONE", tunnelUpper, tunnelLower, triggerAtr * tunnelSweepToleranceAtr, tunnelMainTime1, tunnelMainPrice1, tunnelMainTime2, tunnelMainPrice2, tunnelParallelTime, tunnelParallelPrice, tunnelAnchorVersion)
            f_send_signal("OPEN", "BUY", buyEntryReason, tradeEntry, noExitPrice, tradeInitialStop, tradeBeTrigger, tradeTp2, tradeScore, tradeSignalId, tradeTargetSource, buyTunnelContext)
    else if sellEntryConfirmed and not buyEntryConfirmed
        sellSignal := true
        tradeDirection := -1
        tradeEntry := close
        stopAnchor = sellEntryFromTunnel ? math.max(sellTunnelSweepLevel, sellTunnelSweepHigh) : math.max(sellClusterHi, na(sellSweepHigh) ? sellClusterHi : sellSweepHigh)
        tradeInitialStop := stopAnchor + triggerAtr * slAtrBuffer
        tradeRisk := math.max(tradeInitialStop - tradeEntry, syminfo.mintick)
        tradeBeTrigger := tradeEntry - tradeRisk * beAtR
        przTarget = f_target_below(tradeEntry, tradeRisk * minimumPrzTargetR, buyDHi, buyH4Hi, buyH1Hi)
        tradeTp2 := na(przTarget) ? tradeEntry - tradeRisk * tp2AtR : przTarget
        tradeTargetSource := na(przTarget) ? "R_FALLBACK" : "DEMAND_PRZ"
        tradeSignalId := str.replace_all(str.replace_all(syminfo.ticker + "-" + str.tostring(time_close) + "-SELL", ":", ""), "/", "")
        tradeScore := sellClusterScore
        breakEvenArmed := false
        runnerActive := false
        entryBar := bar_index
        lifecycle := "OPEN_SELL"
        if marketOpen
            sellEntryReason = sellEntryFromTunnel ? "TUNNEL_SWEEP_GC_RVOL_WALL_PA_HA15_SELL" : "PRZ_GC_RVOL_WALL_PA_HA15_SELL"
            sellTunnelContext = f_tunnel_context_json(tunnelDirectionText, tunnelTf, sellEntryFromTunnel ? "UPPER" : "NONE", tunnelUpper, tunnelLower, triggerAtr * tunnelSweepToleranceAtr, tunnelMainTime1, tunnelMainPrice1, tunnelMainTime2, tunnelMainPrice2, tunnelParallelTime, tunnelParallelPrice, tunnelAnchorVersion)
            f_send_signal("OPEN", "SELL", sellEntryReason, tradeEntry, noExitPrice, tradeInitialStop, tradeBeTrigger, tradeTp2, tradeScore, tradeSignalId, tradeTargetSource, sellTunnelContext)

    if buySignal or sellSignal
        buySweepArmed := false
        sellSweepArmed := false
        buySweepLow := na
        sellSweepHigh := na
        buySweepAge := 0
        sellSweepAge := 0
        buyGcRvolWallArmed := false
        sellGcRvolWallArmed := false
        buyGcRvolWallAge := 0
        sellGcRvolWallAge := 0
        buyPaZoneArmed := false
        sellPaZoneArmed := false
        buyPaZoneAge := 0
        sellPaZoneAge := 0
        buyEntryArmed := false
        sellEntryArmed := false
        buyEntryArmAge := 0
        sellEntryArmAge := 0
        buyEntryFromTunnel := false
        sellEntryFromTunnel := false
        buyTunnelSweepArmed := false
        sellTunnelSweepArmed := false
        buyTunnelSweepAge := 0
        sellTunnelSweepAge := 0
        buyTunnelSweepLevel := na
        sellTunnelSweepLevel := na
        buyTunnelSweepLow := na
        sellTunnelSweepHigh := na
        buyTunnelAnchorVersion := na
        sellTunnelAnchorVersion := na

beStop = tradeDirection == 1 ? tradeEntry + syminfo.mintick * beOffsetTicks : tradeEntry - syminfo.mintick * beOffsetTicks
activeStop = tradeDirection == 0 ? na : breakEvenArmed ? beStop : tradeInitialStop

if barstate.isconfirmed and tradeDirection != 0 and bar_index > entryBar
    if tradeDirection == 1
        if low <= activeStop
            exitReason := breakEvenArmed ? "BREAK_EVEN" : "INITIAL_STOP"
            exitPrice := activeStop
        else if not breakEvenArmed and high >= tradeBeTrigger
            breakEvenArmed := true
            if requireStructureRun and structureBias != 1
                exitReason := "TP1_NO_BULL_STRUCTURE"
                exitPrice := tradeBeTrigger
            else
                runnerActive := true
                lifecycle := "RUNNER_BUY"
        else if breakEvenArmed and high >= tradeTp2
            exitReason := tradeTargetSource == "SUPPLY_PRZ" ? "OPPOSING_PRZ_TARGET" : "R_FALLBACK_TARGET"
            exitPrice := tradeTp2
        else if newTriggerBar and sellEntryConfirmed
            exitReason := "HA15_TWO_BEAR_LOWER_REVERSE"
            exitPrice := close
            reverseDirection := "SELL"
            reverseEntry := close
            reverseStopAnchor = sellEntryFromTunnel ? math.max(sellTunnelSweepLevel, sellTunnelSweepHigh) : math.max(sellClusterHi, na(sellSweepHigh) ? sellClusterHi : sellSweepHigh)
            reverseSl := reverseStopAnchor + triggerAtr * slAtrBuffer
            reverseRisk := math.max(reverseSl - reverseEntry, syminfo.mintick)
            reverseTp1 := reverseEntry - reverseRisk * beAtR
            reversePrzTarget = f_target_below(reverseEntry, reverseRisk * minimumPrzTargetR, buyDHi, buyH4Hi, buyH1Hi)
            reverseTp2 := na(reversePrzTarget) ? reverseEntry - reverseRisk * tp2AtR : reversePrzTarget
            reverseTargetSource := na(reversePrzTarget) ? "R_FALLBACK" : "DEMAND_PRZ"
            reverseScore := sellClusterScore
            reverseSignalId := str.replace_all(str.replace_all(syminfo.ticker + "-" + str.tostring(time_close) + "-REV-SELL", ":", ""), "/", "")
        else if runnerActive and exitOnStructureFlip and newStructureBar and bearStructureBreak
            exitReason := "BEAR_STRUCTURE_FLIP"
            exitPrice := close
    else
        if high >= activeStop
            exitReason := breakEvenArmed ? "BREAK_EVEN" : "INITIAL_STOP"
            exitPrice := activeStop
        else if not breakEvenArmed and low <= tradeBeTrigger
            breakEvenArmed := true
            if requireStructureRun and structureBias != -1
                exitReason := "TP1_NO_BEAR_STRUCTURE"
                exitPrice := tradeBeTrigger
            else
                runnerActive := true
                lifecycle := "RUNNER_SELL"
        else if breakEvenArmed and low <= tradeTp2
            exitReason := tradeTargetSource == "DEMAND_PRZ" ? "OPPOSING_PRZ_TARGET" : "R_FALLBACK_TARGET"
            exitPrice := tradeTp2
        else if newTriggerBar and buyEntryConfirmed
            exitReason := "HA15_TWO_BULL_HIGHER_REVERSE"
            exitPrice := close
            reverseDirection := "BUY"
            reverseEntry := close
            reverseStopAnchor = buyEntryFromTunnel ? math.min(buyTunnelSweepLevel, buyTunnelSweepLow) : math.min(buyClusterLo, na(buySweepLow) ? buyClusterLo : buySweepLow)
            reverseSl := reverseStopAnchor - triggerAtr * slAtrBuffer
            reverseRisk := math.max(reverseEntry - reverseSl, syminfo.mintick)
            reverseTp1 := reverseEntry + reverseRisk * beAtR
            reversePrzTarget = f_target_above(reverseEntry, reverseRisk * minimumPrzTargetR, sellDLo, sellH4Lo, sellH1Lo)
            reverseTp2 := na(reversePrzTarget) ? reverseEntry + reverseRisk * tp2AtR : reversePrzTarget
            reverseTargetSource := na(reversePrzTarget) ? "R_FALLBACK" : "SUPPLY_PRZ"
            reverseScore := buyClusterScore
            reverseSignalId := str.replace_all(str.replace_all(syminfo.ticker + "-" + str.tostring(time_close) + "-REV-BUY", ":", ""), "/", "")
        else if runnerActive and exitOnStructureFlip and newStructureBar and bullStructureBreak
            exitReason := "BULL_STRUCTURE_FLIP"
            exitPrice := close

if exitReason != ""
    exitSignal := true
    exitedDirection := tradeDirection == 1 ? "BUY" : "SELL"
    isReverse = reverseDirection != "NONE"
    if marketOpen
        if isReverse
            f_send_reverse_close(exitedDirection, exitReason, tradeEntry, exitPrice, activeStop, tradeBeTrigger, tradeTp2, tradeScore, tradeSignalId, tradeTargetSource, reverseDirection, reverseEntry, reverseSl, reverseTp1, reverseTp2, reverseScore, reverseSignalId, reverseTargetSource)
        else
            f_send_signal("CLOSE", exitedDirection, exitReason, tradeEntry, exitPrice, activeStop, tradeBeTrigger, tradeTp2, tradeScore, tradeSignalId, tradeTargetSource, "")
    if isReverse
        tradeDirection := reverseDirection == "BUY" ? 1 : -1
        tradeEntry := reverseEntry
        tradeInitialStop := reverseSl
        tradeRisk := reverseRisk
        tradeBeTrigger := reverseTp1
        tradeTp2 := reverseTp2
        tradeTargetSource := reverseTargetSource
        tradeSignalId := reverseSignalId
        tradeScore := reverseScore
        breakEvenArmed := false
        runnerActive := false
        entryBar := bar_index
        cooldown := 0
        buySignal := reverseDirection == "BUY"
        sellSignal := reverseDirection == "SELL"
        buyEntryArmed := false
        sellEntryArmed := false
        buyEntryArmAge := 0
        sellEntryArmAge := 0
        buyEntryFromTunnel := false
        sellEntryFromTunnel := false
        buyGcRvolWallArmed := false
        sellGcRvolWallArmed := false
        buyGcRvolWallAge := 0
        sellGcRvolWallAge := 0
        buyPaZoneArmed := false
        sellPaZoneArmed := false
        buyPaZoneAge := 0
        sellPaZoneAge := 0
        buySweepArmed := false
        sellSweepArmed := false
        buySweepLow := na
        sellSweepHigh := na
        buySweepAge := 0
        sellSweepAge := 0
        buyTunnelSweepArmed := false
        sellTunnelSweepArmed := false
        buyTunnelSweepAge := 0
        sellTunnelSweepAge := 0
        buyTunnelSweepLevel := na
        sellTunnelSweepLevel := na
        buyTunnelSweepLow := na
        sellTunnelSweepHigh := na
        buyTunnelAnchorVersion := na
        sellTunnelAnchorVersion := na
        lifecycle := reverseDirection == "BUY" ? "REVERSE_PENDING_BUY_ACK" : "REVERSE_PENDING_SELL_ACK"
    else
        tradeDirection := 0
        tradeEntry := na
        tradeInitialStop := na
        tradeRisk := na
        tradeBeTrigger := na
        tradeTp2 := na
        tradeTargetSource := "NONE"
        tradeSignalId := ""
        tradeScore := 0
        breakEvenArmed := false
        runnerActive := false
        entryBar := na
        cooldown := cooldownBars
        lifecycle := "COOLDOWN"

if tradeDirection == 0 and cooldown == 0
    lifecycle := buyEntryArmed ? (buyEntryFromTunnel ? "BUY_TUNNEL_READY_WAIT_HA15_2" : "BUY_PRZ_READY_WAIT_HA15_2") : sellEntryArmed ? (sellEntryFromTunnel ? "SELL_TUNNEL_READY_WAIT_HA15_2" : "SELL_PRZ_READY_WAIT_HA15_2") : buyGcRvolWallArmed ? "BUY_WAIT_PA" : sellGcRvolWallArmed ? "SELL_WAIT_PA" : buyPaZoneArmed ? "BUY_WAIT_GC_RVOL" : sellPaZoneArmed ? "SELL_WAIT_GC_RVOL" : buyTunnelSweepArmed ? "BUY_TUNNEL_SWEEP_ARMED" : sellTunnelSweepArmed ? "SELL_TUNNEL_SWEEP_ARMED" : buySweepArmed ? "BUY_SWEEP_ARMED" : sellSweepArmed ? "SELL_SWEEP_ARMED" : "WAIT_LOCATION"

// =============================================================================
// 8. VISUALS AND DASHBOARD
// =============================================================================

var box buyDBox = na
var box buyH4Box = na
var box buyH1Box = na
var box sellDBox = na
var box sellH4Box = na
var box sellH1Box = na
var box demandClusterBox = na
var box supplyClusterBox = na
var label demandClusterLabel = na
var label supplyClusterLabel = na

if barstate.islast
    boxLeft = math.max(0, bar_index - boxHistoryBars)
    boxRight = bar_index + projectionBars
    labelX = bar_index + math.min(projectionBars - 1, 12)
    if showPrzBoxes
        if na(buyDBox)
            buyDBox := box.new(boxLeft, buyDHi, boxRight, buyDLo, xloc=xloc.bar_index, bgcolor=color.new(color.lime, 94), border_color=color.new(color.lime, 55), border_style=line.style_dotted)
            buyH4Box := box.new(boxLeft, buyH4Hi, boxRight, buyH4Lo, xloc=xloc.bar_index, bgcolor=color.new(color.lime, 95), border_color=color.new(color.lime, 65), border_style=line.style_dotted)
            buyH1Box := box.new(boxLeft, buyH1Hi, boxRight, buyH1Lo, xloc=xloc.bar_index, bgcolor=color.new(color.lime, 96), border_color=color.new(color.lime, 75), border_style=line.style_dotted)
            sellDBox := box.new(boxLeft, sellDHi, boxRight, sellDLo, xloc=xloc.bar_index, bgcolor=color.new(color.red, 94), border_color=color.new(color.red, 55), border_style=line.style_dotted)
            sellH4Box := box.new(boxLeft, sellH4Hi, boxRight, sellH4Lo, xloc=xloc.bar_index, bgcolor=color.new(color.red, 95), border_color=color.new(color.red, 65), border_style=line.style_dotted)
            sellH1Box := box.new(boxLeft, sellH1Hi, boxRight, sellH1Lo, xloc=xloc.bar_index, bgcolor=color.new(color.red, 96), border_color=color.new(color.red, 75), border_style=line.style_dotted)
            demandClusterBox := box.new(boxLeft, buyClusterHi, boxRight, buyClusterLo, xloc=xloc.bar_index, bgcolor=color.new(color.lime, 84), border_color=color.lime)
            supplyClusterBox := box.new(boxLeft, sellClusterHi, boxRight, sellClusterLo, xloc=xloc.bar_index, bgcolor=color.new(color.red, 84), border_color=color.red)
            demandClusterLabel := label.new(labelX, (buyClusterLo + buyClusterHi) / 2.0, "", xloc=xloc.bar_index, style=label.style_label_left, color=color.lime, textcolor=color.black)
            supplyClusterLabel := label.new(labelX, (sellClusterLo + sellClusterHi) / 2.0, "", xloc=xloc.bar_index, style=label.style_label_left, color=color.red, textcolor=color.white)

        box.set_left(buyDBox, boxLeft)
        box.set_right(buyDBox, boxRight)
        box.set_top(buyDBox, buyDHi)
        box.set_bottom(buyDBox, buyDLo)
        box.set_left(buyH4Box, boxLeft)
        box.set_right(buyH4Box, boxRight)
        box.set_top(buyH4Box, buyH4Hi)
        box.set_bottom(buyH4Box, buyH4Lo)
        box.set_left(buyH1Box, boxLeft)
        box.set_right(buyH1Box, boxRight)
        box.set_top(buyH1Box, buyH1Hi)
        box.set_bottom(buyH1Box, buyH1Lo)
        box.set_left(sellDBox, boxLeft)
        box.set_right(sellDBox, boxRight)
        box.set_top(sellDBox, sellDHi)
        box.set_bottom(sellDBox, sellDLo)
        box.set_left(sellH4Box, boxLeft)
        box.set_right(sellH4Box, boxRight)
        box.set_top(sellH4Box, sellH4Hi)
        box.set_bottom(sellH4Box, sellH4Lo)
        box.set_left(sellH1Box, boxLeft)
        box.set_right(sellH1Box, boxRight)
        box.set_top(sellH1Box, sellH1Hi)
        box.set_bottom(sellH1Box, sellH1Lo)
        box.set_left(demandClusterBox, boxLeft)
        box.set_right(demandClusterBox, boxRight)
        box.set_top(demandClusterBox, buyClusterHi)
        box.set_bottom(demandClusterBox, buyClusterLo)
        box.set_left(supplyClusterBox, boxLeft)
        box.set_right(supplyClusterBox, boxRight)
        box.set_top(supplyClusterBox, sellClusterHi)
        box.set_bottom(supplyClusterBox, sellClusterLo)

        label.set_x(demandClusterLabel, labelX)
        label.set_y(demandClusterLabel, (buyClusterLo + buyClusterHi) / 2.0)
        label.set_text(demandClusterLabel, "DEMAND PRZ\n" + str.tostring(buyClusterCount) + " Levels | Score " + str.tostring(buyClusterScore))
        label.set_x(supplyClusterLabel, labelX)
        label.set_y(supplyClusterLabel, (sellClusterLo + sellClusterHi) / 2.0)
        label.set_text(supplyClusterLabel, "SUPPLY PRZ\n" + str.tostring(sellClusterCount) + " Levels | Score " + str.tostring(sellClusterScore))
    else if not na(buyDBox)
        box.delete(buyDBox)
        box.delete(buyH4Box)
        box.delete(buyH1Box)
        box.delete(sellDBox)
        box.delete(sellH4Box)
        box.delete(sellH1Box)
        box.delete(demandClusterBox)
        box.delete(supplyClusterBox)
        label.delete(demandClusterLabel)
        label.delete(supplyClusterLabel)
        buyDBox := na
        buyH4Box := na
        buyH1Box := na
        sellDBox := na
        sellH4Box := na
        sellH1Box := na
        demandClusterBox := na
        supplyClusterBox := na
        demandClusterLabel := na
        supplyClusterLabel := na

buyLoPlot = plot(showHistoricalBands ? buyClusterLo : na, "Historical demand cluster low", color=color.new(color.lime, 35), style=plot.style_linebr)
buyHiPlot = plot(showHistoricalBands ? buyClusterHi : na, "Historical demand cluster high", color=color.new(color.lime, 35), style=plot.style_linebr)
fill(buyLoPlot, buyHiPlot, color=color.new(color.lime, 88), title="Demand PRZ cluster")

sellLoPlot = plot(showHistoricalBands ? sellClusterLo : na, "Historical supply cluster low", color=color.new(color.red, 35), style=plot.style_linebr)
sellHiPlot = plot(showHistoricalBands ? sellClusterHi : na, "Historical supply cluster high", color=color.new(color.red, 35), style=plot.style_linebr)
fill(sellLoPlot, sellHiPlot, color=color.new(color.red, 88), title="Supply PRZ cluster")

plot(showBb ? bbBasis : na, "Confirmed 15m BB basis", color=color.new(color.blue, 20), style=plot.style_stepline)
plot(showBb ? bbUpper : na, "Confirmed 15m BB upper", color=color.new(color.red, 35), style=plot.style_stepline)
plot(showBb ? bbLower : na, "Confirmed 15m BB lower", color=color.new(color.teal, 35), style=plot.style_stepline)

// Draw the current H1 channel from its actual confirmed pivot timestamps. A
// projected M15 series plot changes shape when viewed on H1/H4 and leaves
// disconnected historical fragments. Three xloc.bar_time lines keep exactly
// one frozen geometry on every chart timeframe; M15 remains the only trigger.
tunnelColor = activeTunnelDirection == -1 ? color.orange : activeTunnelDirection == 1 ? color.aqua : color.gray
tunnelParallelAtMain1 = not na(tunnelParallelPrice) and not na(tunnelSlopePerMs) and not na(tunnelMainTime1) and not na(tunnelParallelTime) ? tunnelParallelPrice + tunnelSlopePerMs * float(tunnelMainTime1 - tunnelParallelTime) : na
tunnelParallelAtMain2 = not na(tunnelParallelPrice) and not na(tunnelSlopePerMs) and not na(tunnelMainTime2) and not na(tunnelParallelTime) ? tunnelParallelPrice + tunnelSlopePerMs * float(tunnelMainTime2 - tunnelParallelTime) : na
float tunnelUpperAnchor1 = na
float tunnelUpperAnchor2 = na
float tunnelLowerAnchor1 = na
float tunnelLowerAnchor2 = na
if activeTunnelDirection == -1
    tunnelUpperAnchor1 := tunnelMainPrice1
    tunnelUpperAnchor2 := tunnelMainPrice2
    tunnelLowerAnchor1 := tunnelParallelAtMain1
    tunnelLowerAnchor2 := tunnelParallelAtMain2
else if activeTunnelDirection == 1
    tunnelUpperAnchor1 := tunnelParallelAtMain1
    tunnelUpperAnchor2 := tunnelParallelAtMain2
    tunnelLowerAnchor1 := tunnelMainPrice1
    tunnelLowerAnchor2 := tunnelMainPrice2

tunnelMiddleAnchor1 = na(tunnelUpperAnchor1) or na(tunnelLowerAnchor1) ? na : (tunnelUpperAnchor1 + tunnelLowerAnchor1) / 2.0
tunnelMiddleAnchor2 = na(tunnelUpperAnchor2) or na(tunnelLowerAnchor2) ? na : (tunnelUpperAnchor2 + tunnelLowerAnchor2) / 2.0
tunnelLineReady = showTunnel and tunnelAnchorActive and not na(tunnelMainTime1) and not na(tunnelMainTime2) and not na(tunnelUpperAnchor1) and not na(tunnelUpperAnchor2) and not na(tunnelLowerAnchor1) and not na(tunnelLowerAnchor2)

var line tunnelUpperLine = na
var line tunnelLowerLine = na
var line tunnelMiddleLine = na
var linefill tunnelChannelFill = na
if barstate.islast
    if tunnelLineReady
        if na(tunnelUpperLine)
            tunnelUpperLine := line.new(x1=tunnelMainTime1, y1=tunnelUpperAnchor1, x2=tunnelMainTime2, y2=tunnelUpperAnchor2, xloc=xloc.bar_time, extend=extend.right, color=color.new(tunnelColor, 10), width=2)
            tunnelLowerLine := line.new(x1=tunnelMainTime1, y1=tunnelLowerAnchor1, x2=tunnelMainTime2, y2=tunnelLowerAnchor2, xloc=xloc.bar_time, extend=extend.right, color=color.new(tunnelColor, 10), width=2)
            tunnelMiddleLine := line.new(x1=tunnelMainTime1, y1=tunnelMiddleAnchor1, x2=tunnelMainTime2, y2=tunnelMiddleAnchor2, xloc=xloc.bar_time, extend=extend.right, color=color.new(tunnelColor, 55), style=line.style_dashed)
            tunnelChannelFill := linefill.new(tunnelUpperLine, tunnelLowerLine, color.new(tunnelColor, 94))
        else
            line.set_xy1(tunnelUpperLine, tunnelMainTime1, tunnelUpperAnchor1)
            line.set_xy2(tunnelUpperLine, tunnelMainTime2, tunnelUpperAnchor2)
            line.set_xy1(tunnelLowerLine, tunnelMainTime1, tunnelLowerAnchor1)
            line.set_xy2(tunnelLowerLine, tunnelMainTime2, tunnelLowerAnchor2)
            line.set_xy1(tunnelMiddleLine, tunnelMainTime1, tunnelMiddleAnchor1)
            line.set_xy2(tunnelMiddleLine, tunnelMainTime2, tunnelMiddleAnchor2)
            line.set_color(tunnelUpperLine, color.new(tunnelColor, 10))
            line.set_color(tunnelLowerLine, color.new(tunnelColor, 10))
            line.set_color(tunnelMiddleLine, color.new(tunnelColor, 55))
            linefill.set_color(tunnelChannelFill, color.new(tunnelColor, 94))
    else
        if not na(tunnelChannelFill)
            linefill.delete(tunnelChannelFill)
            tunnelChannelFill := na
        if not na(tunnelUpperLine)
            line.delete(tunnelUpperLine)
            tunnelUpperLine := na
        if not na(tunnelLowerLine)
            line.delete(tunnelLowerLine)
            tunnelLowerLine := na
        if not na(tunnelMiddleLine)
            line.delete(tunnelMiddleLine)
            tunnelMiddleLine := na

plot(showTrade and tradeDirection != 0 ? tradeEntry : na, "Entry", color=color.white, linewidth=2, style=plot.style_linebr)
plot(showTrade and tradeDirection != 0 ? activeStop : na, "Active stop", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(showTrade and tradeDirection != 0 ? tradeBeTrigger : na, "BE trigger / TP1", color=color.yellow, style=plot.style_linebr)
plot(showTrade and tradeDirection != 0 ? tradeTp2 : na, "TP2", color=color.aqua, style=plot.style_linebr)

plotshape(buySignal, title="BUY signal", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="BUY")
plotshape(sellSignal, title="SELL signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")
plotshape(exitSignal, title="Lifecycle exit", style=shape.xcross, location=location.abovebar, color=color.orange, size=size.tiny, text="EXIT")
plotshape(buyTunnelSweepNow and newTriggerBar, title="Confirmed lower-tunnel sweep/reclaim", style=shape.diamond, location=location.belowbar, color=color.new(color.aqua, 5), size=size.tiny, text="T")
plotshape(sellTunnelSweepNow and newTriggerBar, title="Confirmed upper-tunnel sweep/reclaim", style=shape.diamond, location=location.abovebar, color=color.new(color.orange, 5), size=size.tiny, text="T")
plotshape(gcBuyRvolWall and buyEvidenceLocationOk and newTriggerBar, title="GC futures RVOL wall at BUY decision location", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 15), size=size.tiny)
plotshape(gcSellRvolWall and sellEvidenceLocationOk and newTriggerBar, title="GC futures RVOL wall at SELL decision location", style=shape.circle, location=location.abovebar, color=color.new(color.red, 15), size=size.tiny)
plotshape(showH1SourceDots and newEntryConfirmBar and buyH1NormalCandle, title="H1 normal-candle BUY permission", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 20), size=size.tiny)
plotshape(showH1SourceDots and newEntryConfirmBar and sellH1HeikinAshi, title="H1 HA SELL permission", style=shape.circle, location=location.abovebar, color=color.new(color.red, 20), size=size.tiny)

var table dashboard = table.new(position.bottom_left, 2, 18, bgcolor=color.new(color.rgb(25, 25, 25), 5), border_width=1)
if showDashboard and barstate.islast
    contextBias = buyContextOk and not sellContextOk ? "BUY" : sellContextOk and not buyContextOk ? "SELL" : "NEUTRAL"
    triggerText = buyEntryConfirmed ? "BUY HA15 #2" : sellEntryConfirmed ? "SELL HA15 #2" : buyEntryArmed ? "BUY WAIT #2" : sellEntryArmed ? "SELL WAIT #2" : buyTunnelSweepArmed ? "BUY TUNNEL ARMED" : sellTunnelSweepArmed ? "SELL TUNNEL ARMED" : "WAIT LOCATION"
    h1EntryText = buyH1NormalCandle and sellH1HeikinAshi ? "BUY CANDLE + SELL HA" : buyH1NormalCandle ? "BUY CANDLE" : sellH1HeikinAshi ? "SELL HA" : "WAIT"
    gcPermissionText = gcBuyRvolWall ? "BUY SUPPORT" : gcSellRvolWall ? "SELL RESIST" : gcHasData ? "NO LEVEL" : "NO DATA"
    // Location is not direction. Demand/Supply may be a target or a blocked
    // candidate until the asymmetric H1 source, structure and HA15 #2 agree.
    decisionZoneText = buyTunnelLocationOk ? "LOWER TUNNEL" : sellTunnelLocationOk ? "UPPER TUNNEL" : buyDirectionalZone ? "DEMAND PRZ" : sellDirectionalZone ? "SUPPLY PRZ" : ambiguousLocation ? "OVERLAP WAIT" : "MID NO ENTRY"
    table.cell(dashboard, 0, 0, "ALPHA BUFF", text_color=color.white, bgcolor=color.rgb(40, 40, 40))
    table.cell(dashboard, 1, 0, "PINE v2.4.2", text_color=color.yellow, bgcolor=color.rgb(40, 40, 40))
    table.cell(dashboard, 0, 1, "Market / TF", text_color=color.white)
    table.cell(dashboard, 1, 1, (marketOpen ? "OPEN" : "CLOSED") + " / " + (safeTimeframe ? "SAFE" : "USE 5m"), text_color=marketOpen and safeTimeframe ? color.lime : color.orange)
    table.cell(dashboard, 0, 2, "Spot / GC+F", text_color=color.white)
    table.cell(dashboard, 1, 2, str.tostring(close, "#.##") + " / " + (gcHasData ? str.tostring(gcClose, "#.##") : "N/A"), text_color=color.white)
    // This is macro trend context only. The Railway FinalGate owns the actual
    // one-way harmonic execution bias read from the Newday market map.
    table.cell(dashboard, 0, 3, "Trend Context", text_color=color.white)
    table.cell(dashboard, 1, 3, contextBias + "  " + str.tostring(buyContextScore) + "/" + str.tostring(sellContextScore), text_color=contextBias == "BUY" ? color.lime : contextBias == "SELL" ? color.red : color.yellow)
    table.cell(dashboard, 0, 4, "Demand PRZ", text_color=color.white)
    table.cell(dashboard, 1, 4, str.tostring(buyClusterLo, "#.##") + "-" + str.tostring(buyClusterHi, "#.##"), text_color=color.lime)
    table.cell(dashboard, 0, 5, "Demand Cluster", text_color=color.white)
    table.cell(dashboard, 1, 5, str.tostring(buyClusterCount) + " levels / Score " + str.tostring(buyClusterScore), text_color=color.lime)
    table.cell(dashboard, 0, 6, "Supply PRZ", text_color=color.white)
    table.cell(dashboard, 1, 6, str.tostring(sellClusterLo, "#.##") + "-" + str.tostring(sellClusterHi, "#.##"), text_color=color.red)
    table.cell(dashboard, 0, 7, "Supply Cluster", text_color=color.white)
    table.cell(dashboard, 1, 7, str.tostring(sellClusterCount) + " levels / Score " + str.tostring(sellClusterScore), text_color=color.red)
    table.cell(dashboard, 0, 8, "Fib profile", text_color=color.white)
    table.cell(dashboard, 1, 8, (isAsia ? "ASIA " : "DEEP ") + str.tostring(fibNear, "#.###") + "-" + str.tostring(fibDeep, "#.###"), text_color=color.aqua)
    table.cell(dashboard, 0, 9, "PRZ State", text_color=color.white)
    table.cell(dashboard, 1, 9, buyPrzBosThrough ? "BUY BLOCKED: BEAR BOS" : sellPrzBosThrough ? "SELL BLOCKED: BULL BOS" : buyEntryArmed ? (buyEntryFromTunnel ? "BUY TUNNEL READY" : "BUY PRZ READY") : sellEntryArmed ? (sellEntryFromTunnel ? "SELL TUNNEL READY" : "SELL PRZ READY") : buyGcRvolWallArmed ? "BUY WAIT PA" : sellGcRvolWallArmed ? "SELL WAIT PA" : buyPaZoneArmed ? "BUY WAIT GC RVOL" : sellPaZoneArmed ? "SELL WAIT GC RVOL" : buyTunnelSweepArmed ? "BUY TUNNEL SWEEP" : sellTunnelSweepArmed ? "SELL TUNNEL SWEEP" : buySweepArmed ? "BUY PRZ SWEEP" : sellSweepArmed ? "SELL PRZ SWEEP" : "WAIT", text_color=buyEntryArmed or buyGcRvolWallArmed or buyPaZoneArmed or buyTunnelSweepArmed or buySweepArmed ? color.lime : sellEntryArmed or sellGcRvolWallArmed or sellPaZoneArmed or sellTunnelSweepArmed or sellSweepArmed ? color.red : color.gray)
    table.cell(dashboard, 0, 10, "15m Trigger", text_color=color.white)
    table.cell(dashboard, 1, 10, triggerText, text_color=str.contains(triggerText, "BUY") ? color.lime : str.contains(triggerText, "SELL") ? color.red : color.gray)
    table.cell(dashboard, 0, 11, "H1 Entry Source", text_color=color.white)
    table.cell(dashboard, 1, 11, h1EntryText, text_color=buyH1NormalCandle ? color.lime : sellH1HeikinAshi ? color.red : color.gray)
    table.cell(dashboard, 0, 12, "Structure", text_color=color.white)
    table.cell(dashboard, 1, 12, structureEvent, text_color=structureBias == 1 ? color.lime : structureBias == -1 ? color.red : color.gray)
    table.cell(dashboard, 0, 13, "Lifecycle", text_color=color.white)
    table.cell(dashboard, 1, 13, lifecycle, text_color=tradeDirection == 1 ? color.lime : tradeDirection == -1 ? color.red : color.yellow)
    table.cell(dashboard, 0, 14, "Entry / Stop / TP2", text_color=color.white)
    table.cell(dashboard, 1, 14, tradeDirection == 0 ? "-" : str.tostring(tradeEntry, "#.##") + " / " + str.tostring(activeStop, "#.##") + " / " + str.tostring(tradeTp2, "#.##"), text_color=color.white)
    table.cell(dashboard, 0, 15, "TP2 Source / EA", text_color=color.white)
    table.cell(dashboard, 1, 15, tradeTargetSource + " / SIGNAL ONLY", text_color=tradeTargetSource == "SUPPLY_PRZ" or tradeTargetSource == "DEMAND_PRZ" ? color.aqua : color.gray)
    table.cell(dashboard, 0, 16, "GC Contract RVOL", text_color=color.white)
    table.cell(dashboard, 1, 16, (gcHasData ? str.tostring(gcRvol, "#.##") : "N/A") + " / " + gcPermissionText, text_color=gcBuyRvolWall ? color.lime : gcSellRvolWall ? color.red : color.gray)
    table.cell(dashboard, 0, 17, "Location", text_color=color.white)
    table.cell(dashboard, 1, 17, decisionZoneText, text_color=str.contains(decisionZoneText, "DEMAND") or str.contains(decisionZoneText, "LOWER") ? color.lime : str.contains(decisionZoneText, "SUPPLY") or str.contains(decisionZoneText, "UPPER") ? color.red : color.yellow)

