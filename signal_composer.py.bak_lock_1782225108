from signal_schema import SignalDecision

def safe_float(x, default=0.0):
    try:
        return float(x)
    except:
        return default


def compose_signal(kivanc_sig=None, micro_sigs=None, score_result=None):
    micro_sigs = micro_sigs if micro_sigs is not None else []

    kivanc_score = 1 if kivanc_sig else 0

    bos_detected = any(getattr(s, "bos", False) for s in micro_sigs)

    base_score = float(getattr(score_result, "total", 0)) if score_result else 0.0

    if kivanc_sig and getattr(kivanc_sig, "direction", None) in ("BUY", "SELL"):
        return SignalDecision(
            direction=kivanc_sig.direction,
            confidence=0.7,
            score=base_score + kivanc_score,
            reason="kivanc_confirmed"
        )

    return SignalDecision(
        direction="HOLD",
        confidence=0.3,
        score=base_score,
        reason="no_signal"
    )
